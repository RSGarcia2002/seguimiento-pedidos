{
  "name": "@pedidos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/servidor.js",
    "test": "tsx --test test/*.test.ts",
    "datos:operacion": "tsx --env-file-if-exists=.env scripts/poblar-operacion.ts",
    "test:simulacion": "tsx --test test/ia.simulacion.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "tsx": "^4.20.6",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "supertest": "^7.1.4",
    "@types/supertest": "^6.0.3"
  }
}
